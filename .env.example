# Copy to .env and fill in with a real app's values, OR let the Shopify CLI
# manage this for you: `shopify app config link` (against a real Partner/Dev
# Dashboard app) followed by `shopify app dev` populates these automatically
# and does not require a hand-maintained .env file at all -- see README.md.

# From the app record in your Partner/Dev Dashboard organization.
SHOPIFY_API_KEY=
SHOPIFY_API_SECRET=

# Comma-separated Admin API access scopes. Empty is correct for this app --
# see the comment in shopify.app.toml's [access_scopes] block for why.
SCOPES=

# The public URL this app is reachable at. In local dev via `shopify app dev`
# this is a CLI-managed tunnel URL; the CLI sets this env var for you. In
# production this is your real deployed URL.
SHOPIFY_APP_URL=

# Optional: only needed if you're serving the app from a custom domain
# instead of the *.myshopify.com / admin.shopify.com iframe host.
SHOP_CUSTOM_DOMAIN=
